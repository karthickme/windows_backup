{
  "name": "Allowed branch names",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/testing",
        "refs/heads/feature/**",
        "refs/heads/fix/**",
        "refs/heads/deps/**",
        "refs/heads/hotfix/**"
      ]
    }
  },
  "rules": [
    { "type": "creation" }
  ]
}
